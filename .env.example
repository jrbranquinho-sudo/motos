# -------------------------------------------------------------
# MotoShop SaaS — Variáveis de Ambiente de Exemplo
# -------------------------------------------------------------

# Configuração do Banco de Dados Turso (LibSQL)
# Obtenha executando: turso db show motos-db --url
TURSO_DATABASE_URL="libsql://motos-db-[seu-usuario].turso.io"

# Obtenha executando: turso db tokens create motos-db
TURSO_AUTH_TOKEN="seu-turso-auth-token"

# URL da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
